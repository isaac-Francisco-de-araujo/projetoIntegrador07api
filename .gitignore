# Artefatos gerados e ferramentas locais
/target/
**/node_modules/
/.opencode/
/.env
/.env.*
!.env.example
*.log
*.class
**/__pycache__/
*.pyc
# Dados operacionais ficam no disco local/backup, fora do versionamento
/arquivos/
/database/*.mv.db
/database/*.trace.db
/database/*.lock.db
/src/test/resources/*-cte.xml
# Configurações pessoais
/.idea/
/.vscode/
*.iml
